# ==============================================================================
# LiveSubs Configuration
# ==============================================================================
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Inference Credentials (Groq Cloud)
# ------------------------------------------------------------------------------
# Free API Key available at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here
# Optional comma-separated keys for automatic round-robin rotation and 429 backoff:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# AI Models
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_CHAT_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 2. Language Matrix
# ------------------------------------------------------------------------------
# Supported languages: en, es, pt (or auto for dynamic source detection)
# When SOURCE_LANG == TARGET_LANG, LLM translation is bypassed (0 token overhead)
SOURCE_LANG=en
TARGET_LANG=es

# ------------------------------------------------------------------------------
# 3. Domain Biasing & Technical Glossary
# ------------------------------------------------------------------------------
# Path to glossary file for Whisper prompt conditioning and translation guardrails
GLOSSARY_FILE=glossary.txt
# Additional comma-separated terms (optional)
GLOSSARY_TERMS=pipeline, deploy, commit, merge, middleware, pull request

# ------------------------------------------------------------------------------
# 4. Message Broker & In-Memory Cache (Valkey / Redis)
# ------------------------------------------------------------------------------
# Use 'localhost' for native local deployment, 'valkey' for Docker Compose
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_CHANNEL=subtitles:live
VALKEY_HISTORY_KEY=subtitles:history

# ------------------------------------------------------------------------------
# 5. Audio Capture & VAD (Voice Activity Detection) Parameters
# ------------------------------------------------------------------------------
SAMPLE_RATE=16000
CHUNK_SECONDS=4.0
MAX_CHUNK_SECONDS=5.5
PAUSE_SILENCE_SECONDS=0.48
MIN_SPEECH_DURATION=0.40
VAD_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# 6. Web Server & WebSocket Gateway
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
