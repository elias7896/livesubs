# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE SUBTITULADO Y TRADUCCIÓN EN VIVO
# ==============================================================================
# Copia este archivo a `.env` y configura tus credenciales:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales de Inferencia de IA (Groq Cloud - Tier Gratuito)
# ------------------------------------------------------------------------------
# Obtén tu API Key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# Modelos a utilizar en Groq Cloud
GROQ_ASR_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_CHAT_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 2. Matriz Multilingüe Dinámica (Sprint 1)
# ------------------------------------------------------------------------------
# Pares soportados: EN->ES, ES->ES (nativo), ES->EN, EN->PT, ES->PT
# Si SOURCE_LANG == TARGET_LANG se omite la llamada a LLaMA (bypass directo)
SOURCE_LANG=en
TARGET_LANG=es

# ------------------------------------------------------------------------------
# 3. Glosario de Jerga Técnica & Slang (Domain Bias - Sprint 1)
# ------------------------------------------------------------------------------
# Ruta al archivo de términos para acondicionar Whisper y preservar en LLaMA
GLOSSARY_FILE=glossary.txt
# Términos adicionales separados por coma (opcional)
GLOSSARY_TERMS=pipeline, deploy, commit, merge, middleware, pull request

# ------------------------------------------------------------------------------
# 4. Broker y Caché (Valkey / Redis)
# ------------------------------------------------------------------------------
# Para despliegue local nativo usa 'localhost'. En Docker Compose se usa 'valkey'.
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_CHANNEL=subtitles:live
VALKEY_HISTORY_KEY=subtitles:history

# ------------------------------------------------------------------------------
# 5. Parámetros de Audio y VAD (Detección de Voz)
# ------------------------------------------------------------------------------
SAMPLE_RATE=16000
CHUNK_SECONDS=4.5
MAX_CHUNK_SECONDS=7.5
PAUSE_SILENCE_SECONDS=0.58
MIN_SPEECH_DURATION=0.45
VAD_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# 6. Servidor Web y Distribución WebSockets
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
